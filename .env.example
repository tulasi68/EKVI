# Application
APP_NAME=EKVI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Database (Postgres + pgvector)
DATABASE_URL=postgresql+asyncpg://ekvi:ekvi@localhost:5432/ekvi
DATABASE_URL_SYNC=postgresql://ekvi:ekvi@localhost:5432/ekvi

# Object storage (local filesystem for prototype; S3 later)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/object_store

# Queue (in-process / Redis later)
QUEUE_BACKEND=memory

# AI provider (adapter pattern — swap without domain changes)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# For private / Azure / Anthropic later: set AI_PROVIDER and corresponding keys

# Ingestion limits
MAX_UPLOAD_SIZE_MB=50
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv,text/plain,text/markdown

# Logging
LOG_LEVEL=INFO
